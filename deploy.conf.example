# Copy this file to deploy.conf and adjust. deploy.conf is gitignored
# (machine-specific connection details).
#
# DEPLOY_PATH is the repository on the server, NOT the web root. The web root
# is DEPLOY_PATH/public; set that in DreamHost under Manage Domains.
#
# Use the host that accepts this machine's SSH key. The site's own host name
# may not be the right SSH target.
#
DEPLOY_USER=eclecity
DEPLOY_HOST=eclecity.net
DEPLOY_PATH=/home/eclecity/relay.eclecity.net
# DEPLOY_PORT=22
