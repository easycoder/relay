# Stopgap for the window before DreamHost's Web Directory for
# relay.eclecity.net is changed to .../public.
#
# Once the web root is public/, this file is outside the served tree and has
# no effect. It exists so the repository cannot be read over HTTP if the web
# root is ever pointed here by mistake.

# Never serve source, admin scripts, database files or documentation.
RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 ^/(db|scripts|src|templates|vendor|node_modules|content)(/|$)

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(bootstrap\.php|deploy\.sh|deploy\.conf|config\.php|config\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|log|sh)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.example(\..*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "\.eclecity\.net\.txt$">
    Require all denied
</FilesMatch>

# While the root is still the repository, serve the public tree. The -f guard
# means this does nothing if the file is not there (for example if this file
# has ended up inside public/ by mistake), so it cannot turn every URL into a
# 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/public/index.php -f
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
